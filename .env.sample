# Удалить ".sample" в названии, подставить свои значения

#settings.py
SECRET_KEY=secret_key
DEBUG=debug(True/False)

# DATABASE настройки
NAME=название_БД
USER=пользователь_БД
PASSWORD=пароль_БД
HOST=хост_БД
PORT=порт_БД

MY_EMAIL=email

# данные для суперюзера в users/management/commands/createadmin.py
ADMIN_EMAIL=почта
ADMIN_USERNAME=юзернейм
ADMIN_PASSWORD=пароль

# Названия папок для превью моделей Course и Lesson
# Если не писать - default 'course_preview/' и 'lesson_preview/' в media/
COURSE_DIR=cousre_dir
LESSON_DIR=lesson_dir

# API ключ от http://stripe.com
STRIPE_API_KEY=api_key
